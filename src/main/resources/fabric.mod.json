{
	"schemaVersion": 1,
	"id": "dualswords",
	"version": "${version}",
	"name": "Dual Swords",
	"description": "Adds dual wielding and parry/riposte mechanics to Minecraft. Part of the Combat+ collection.",
	"authors": [
		"Provismet"
	],

	"contact": {
		"homepage": "https://github.com/Provismet/Dual-Swords",
		"sources": "https://github.com/Provismet/Dual-Swords",
		"issues": "https://github.com/Provismet/Dual-Swords/issues"
	},

	"license": "Lily License v1.1",
	"icon": "assets/dualswords/icon.png",
	"environment": "*",
	
	"entrypoints": {
		"main": [
			"com.provismet.dualswords.DualSwordsMain"
		],
		"client": [
			"com.provismet.dualswords.DualSwordsClient"
		],
		"fabric-datagen": [
			"com.provismet.dualswords.datagen.DualSwordsDatagen"
		]
	},

	"mixins": [
		"dualswords.mixins.json",
		{
			"environment": "client",
			"config": "dualswords.client.mixins.json"
		}
	],
	"accessWidener": "dualswords.accesswidener",

	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
        "combat-plus": "*"
	},

	"custom": {
		"modmenu": {
			"links": {
				"wiki.lilylib.link": "https://github.com/Provismet/Dual-Swords/wiki"
			}
		}
	}
}